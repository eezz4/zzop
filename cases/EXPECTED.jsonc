  // CONTROL FILES: ANY finding at one of these paths counts as a false positive, whatever the rule.
  //
  // Populated 2026-07-26 with the `decoy` tree (36 files, ~70 near-miss cases). Before that this array was
  // EMPTY and precision was measured almost entirely by the per-module `good` exports -- i.e. "does the
  // rule stay quiet on the line right next to the planted defect", which is a much weaker question than
  // "does it stay quiet across a file of ordinary code that RESEMBLES what it looks for".
  //
  // The invariant that makes these worth anything is IN-SCOPE-NESS: every rule here is gated by
  // file_pattern / file_exclude_pattern / require_file, and a decoy that fails any gate was never
  // evaluated -- its silence would inflate precision for free. Each file's header states which gate it
  // satisfies and how, and trees/decoy/README.md collects the reasoning. The strongest of them are the
  // ones whose line_pattern DOES match and whose exclude_pattern / require_file_absent is what produces
  // the silence (interval-no-clear, body-limit-missing, no-system-dialogs, timing-unsafe-compare,
  // sql.no-where, db.unawaited-write): those exercise the veto arms, which is the half of a matcher most
  // likely to rot without anyone noticing.
  //
  // Two rules DID fire here on the first run -- sql/app-side-aggregation-{reduce,filter-length}, because
  // the first draft put a `findMany()` and the `.reduce(` in one method, which is precisely the pattern
  // those rules target. That was adjudicated as a BAD DECOY, not a rule defect: the file was rewritten to
  // split fetch from aggregation (so it now probes method-scoping instead), rather than the firings being
  // labeled into truth. Recording it here because "a decoy fired, so relabel it" is the exact failure mode
  // this array has to resist.
  "benign": [
    "decoy/api/reliability.console-in-be.decoy.ts",
    "decoy/api/sql.nplus1.decoy.ts",
    "decoy/api/sql.race-condition-toctou.decoy.ts",
    "decoy/index.ts",
    "decoy/lib/browser.no-document-write.decoy.ts",
    "decoy/lib/browser.no-system-dialogs.decoy.ts",
    "decoy/lib/db.float-money-compare.decoy.ts",
    "decoy/lib/db.unawaited-write.decoy.ts",
    "decoy/lib/db.update-delete-no-where.decoy.ts",
    "decoy/lib/dead.dynamic-import.decoy.ts",
    "decoy/lib/dead.dynamic-loader.ts",
    "decoy/lib/dead.reexport-chain.decoy.ts",
    "decoy/lib/egress.http-url-literal.decoy.ts",
    "decoy/lib/reexports.ts",
    "decoy/lib/reliability.body-limit-missing.decoy.ts",
    "decoy/lib/reliability.console-in-loop.decoy.ts",
    "decoy/lib/reliability.console-write.decoy.cs",
    "decoy/lib/reliability.console-write.decoy.go",
    "decoy/lib/reliability.console-write.decoy.java",
    "decoy/lib/reliability.interval-no-clear.decoy.ts",
    "decoy/lib/security.api-key-in-url.decoy.ts",
    "decoy/lib/security.conn-string-credentials.decoy.ts",
    "decoy/lib/security.cors-wildcard.decoy.ts",
    "decoy/lib/security.eval-dynamic-code.decoy.ts",
    "decoy/lib/security.hardcoded-secret.decoy.ts",
    "decoy/lib/security.high-entropy-secret.decoy.ts",
    "decoy/lib/security.jwt-none-algorithm.decoy.ts",
    "decoy/lib/security.localstorage-jwt.decoy.ts",
    "decoy/lib/security.raw-query-unsafe-api.decoy.ts",
    "decoy/lib/security.cmd-injection.decoy.java",
    "decoy/lib/security.process-exec.decoy.ts",
    "decoy/lib/security.shell-exec-interpolation.decoy.ts",
    "decoy/lib/security.timing-unsafe-compare.decoy.ts",
    "decoy/lib/security.hash-call.decoy.py",
    "decoy/lib/security.weak-password-hash.decoy.ts",
    "decoy/lib/security.weak-token-random.decoy.ts",
    "decoy/lib/sql.app-side-aggregation.decoy.ts",
    "decoy/lib/sql.no-where.decoy.ts",
    "decoy/lib/sql.select-star.decoy.ts",
    "decoy/lib/typescript.as-cast.decoy.ts",
    "decoy/lib/typescript.parseint-no-radix.decoy.ts",
