  "sdk/billingPage.ts:1": ["cross-layer/untraced-client-import-no-visible-consume"],
  "trpc/router.ts:9": ["cross-layer/unconsumed-procedure"],
  "unresolved/gateway.ts:8": ["cross-layer/unresolved-consume-ratio"],
  "unresolved/gateway.ts:9": ["cross-layer/method-mismatch"],
  // The `worker` half of the `table:order` pair — see the note on "api/src/queries.ts:22". Adjudicated by
  // reading this line: it is `worker`'s own `getPrisma().order.findMany` call, and the fixture's header
  // comment states the intent ("A distinct source (`worker`) touching the SAME table"). Before the
  // per-source change this line reported nothing and `api` alone carried the whole finding.
  "worker/jobs.ts:8": ["cross-layer/db-table-name-in-multiple-sources"],
  "web/rules/be-security.localstorage-jwt.ts:6": ["security/localstorage-jwt"],
  "web/rules/be-security.secret-env-in-fe.tsx:3": ["reliability/env-outside-config","security/secret-env-in-fe"],
  "web/rules/browser.no-document-write.ts:3": ["browser/no-document-write"],
  "web/rules/browser.no-system-dialogs.ts:5": ["browser/no-system-dialogs"],
  "web/rules/dead.orphan.tsx:1": ["dead-candidates"],
  "web/rules/dead.orphan.tsx:4": ["unimported-export"],
  "web/rules/fullstack.get-with-body.ts:5": ["egress/get-and-body"],
  "web/rules/fullstack.mixed-content-egress.ts:2": ["egress/http-url-literal"],
  "web/rules/typescript.as-cast.tsx:2": ["typescript/as-cast","typescript/no-explicit-any"],
  "web/rules/typescript.async-handler-no-try.tsx:6": ["typescript/async-handler-no-try"],
  "web/rules/typescript.no-explicit-any.ts:2": ["typescript/no-explicit-any"],
  "web/rules/typescript.unhandled-promise-use-effect.tsx:8": ["typescript/use-effect-async-callback"],
  "xbe/provides.ts:12": ["cross-layer/unconsumed-endpoint"],
  "xbe/provides.ts:18": ["cross-layer/external-host-in-multiple-sources"],
  "xbe/provides.ts:6": ["cross-layer/duplicate-route"],
  "xbe/provides.ts:7": ["cross-layer/unconsumed-endpoint"],
  "xbe/provides.ts:8": ["cross-layer/unconsumed-mutation-endpoint","mutating-route-no-auth"],
  // MERGED KEY (was "<cross>/provides.ts:13"): route-shadowing anchors at xbe2's PATTERN provide site,
  // which is this same line. Under the old "<cross>" bucket this key was one line number away from
  // colliding with xbe/provides.ts -- both trees have a `provides.ts`.
  // The xbe2 half of the `GET /widgets` collision. Its xbe twin is `xbe/provides.ts:6` above — one copy
  // per providing source since 2026-07-29, so the pair is the finding, not a duplicate of it.
  "xbe2/provides.ts:9": ["cross-layer/duplicate-route"],
  "xbe2/provides.ts:13": ["cross-layer/route-shadowing","cross-layer/unconsumed-endpoint"],
  "xbe2/provides.ts:17": ["cross-layer/unconsumed-endpoint"],
  "xfe/consumes.ts:10": ["cross-layer/external-shadow-internal"],
  "xfe/consumes.ts:11": ["cross-layer/ambiguous-consume"],
  "xfe/consumes.ts:12": ["cross-layer/path-near-miss"],
  "xfe/consumes.ts:16": ["cross-layer/external-base-url-drift"],
  "xfe/consumes.ts:19": ["cross-layer/external-version-inconsistent"],
  "xfe/consumes.ts:5": ["cross-layer/method-mismatch","cross-layer/unprovided-mutation-call"],
  "xfe/consumes.ts:6": ["cross-layer/version-skew"],
  // MERGED KEYS (were "<cross>/consumes.ts:{7,8}"): the cross-layer external-* rule and the per-tree rule
  // land on the same consume line -- 10.0.0.5 is both an IP literal and private-range egress; the vendor
  // URL carries both a secret query param (cross) and an api key (per-tree).
  "xfe/consumes.ts:7": ["cross-layer/external-ip-literal","egress/localhost-url-literal-committed"],
  // `external-host-in-multiple-sources` is the xfe half of the vendor.example.com pair; `xbe/provides.ts:18`
  // above is the other. Same one-copy-per-participating-source change as duplicate-route, and the reason
  // it matters here is that the two calling sites live in DIFFERENT trees — a single anchor made the
  // finding disappear whenever the alphabetically-first tree was excluded.
  "xfe/consumes.ts:8": ["cross-layer/external-secret-in-url","security/api-key-in-url","cross-layer/external-host-in-multiple-sources"],
  "xfe/consumes.ts:9": ["cross-layer/unprovided-mutation-call"],

  // CONTROL FILES: ANY finding at one of these paths counts as a false positive, whatever the rule.
  //
  // Populated 2026-07-26 with the `decoy` tree (36 files, ~70 near-miss cases). Before that this array was
  // EMPTY and precision was measured almost entirely by the per-module `good` exports -- i.e. "does the
  // rule stay quiet on the line right next to the planted defect", which is a much weaker question than
  // "does it stay quiet across a file of ordinary code that RESEMBLES what it looks for".
  //
  // The invariant that makes these worth anything is IN-SCOPE-NESS: every rule here is gated by
  // file_pattern / file_exclude_pattern / require_file, and a decoy that fails any gate was never
  // evaluated -- its silence would inflate precision for free. Each file's header states which gate it
  // satisfies and how, and trees/decoy/README.md collects the reasoning. The strongest of them are the
  // ones whose line_pattern DOES match and whose exclude_pattern / require_file_absent is what produces
  // the silence (interval-no-clear, body-limit-missing, no-system-dialogs, timing-unsafe-compare,
  // sql.no-where, db.unawaited-write): those exercise the veto arms, which is the half of a matcher most
  // likely to rot without anyone noticing.
  //
  // Two rules DID fire here on the first run -- sql/app-side-aggregation-{reduce,filter-length}, because
  // the first draft put a `findMany()` and the `.reduce(` in one method, which is precisely the pattern
  // those rules target. That was adjudicated as a BAD DECOY, not a rule defect: the file was rewritten to
  // split fetch from aggregation (so it now probes method-scoping instead), rather than the firings being
  // labeled into truth. Recording it here because "a decoy fired, so relabel it" is the exact failure mode
  // this array has to resist.
  "benign": [
    "decoy/api/reliability.console-in-be.decoy.ts",
    "decoy/api/sql.nplus1.decoy.ts",
    "decoy/api/sql.race-condition-toctou.decoy.ts",
    "decoy/index.ts",
    "decoy/lib/browser.no-document-write.decoy.ts",
    "decoy/lib/browser.no-system-dialogs.decoy.ts",
    "decoy/lib/db.float-money-compare.decoy.ts",
    "decoy/lib/db.unawaited-write.decoy.ts",
    "decoy/lib/db.update-delete-no-where.decoy.ts",
    "decoy/lib/dead.dynamic-import.decoy.ts",
    "decoy/lib/dead.dynamic-loader.ts",
    "decoy/lib/dead.reexport-chain.decoy.ts",
    "decoy/lib/egress.http-url-literal.decoy.ts",
    "decoy/lib/reexports.ts",
    "decoy/lib/reliability.body-limit-missing.decoy.ts",
    "decoy/lib/reliability.interval-no-clear.decoy.ts",
    "decoy/lib/security.api-key-in-url.decoy.ts",
    "decoy/lib/security.conn-string-credentials.decoy.ts",
    "decoy/lib/security.cors-wildcard.decoy.ts",
    "decoy/lib/security.eval-dynamic-code.decoy.ts",
    "decoy/lib/security.hardcoded-secret.decoy.ts",
    "decoy/lib/security.jwt-none-algorithm.decoy.ts",
    "decoy/lib/security.localstorage-jwt.decoy.ts",
    "decoy/lib/security.raw-query-unsafe-api.decoy.ts",
    "decoy/lib/security.shell-exec-interpolation.decoy.ts",
    "decoy/lib/security.timing-unsafe-compare.decoy.ts",
    "decoy/lib/security.weak-password-hash.decoy.ts",
    "decoy/lib/security.weak-token-random.decoy.ts",
    "decoy/lib/sql.app-side-aggregation.decoy.ts",
    "decoy/lib/sql.no-where.decoy.ts",
    "decoy/lib/sql.select-star.decoy.ts",
    "decoy/lib/typescript.as-cast.decoy.ts",
    "decoy/lib/typescript.parseint-no-radix.decoy.ts",
    "decoy/services/reliability.fetch-no-timeout.decoy.ts",
    "decoy/services/reliability.json-parse-no-try.decoy.ts",
    "decoy/web/security.secret-env-in-fe.decoy.ts"
  ],

  // KNOWN CAPABILITY GAPS -- the third disposition (added 2026-07-29 together with the scorer support;
  // see the `gap` header in scripts/measure/benchmark.mjs). Same "<sourceId>/<path>:<line>": [ruleId]
  // shape as an expectation, and it means: THIS SHOULD FIRE ONCE A KNOWN CAPABILITY LANDS, AND TODAY IT
  // DOES NOT. Excluded from TP/FN/FP; counted and printed as `GAP n/N closed` in every run; exit-zero
  // while open; exit-NONZERO the day one fires, because that is progress to be promoted into an ordinary
  // expectation by hand and never absorbed. `scripts/detection-expected-baseline.txt` carries a third
  // column so an entry here cannot be quietly deleted -- a gap costs nothing in the score, so that column
  // is the only thing that would notice.
  //
  // THIS IS NOT A SUPPRESSION LIST. An entry earns its place by naming the capability, the code that
  // refuses it today, and what would close it. A FN with no named cause does not belong here; it belongs
  // in the score.
  //
  // EMPTY IS THE HEALTHY STATE, and it is empty right now. The two entries it held -- the consume side of
  // the unreadable-client-base shape, one per negative-case pair -- were closed by
  // `trees[].topology.clientBase` and promoted into ordinary expectations at
  // `feaxios/pages/articles.ts:39` and `fegensdk/api/Api.ts:20` (see the negative-case-pairs note above
  // for what that promotion cost and why the harness made it a hand edit). The disposition stays declared
  // rather than deleted because the next acknowledged gap should be written here, not re-invented.
  "gap": {},

  // Expectations anchored in files deliberately kept OUT of the tracked tree, as "<sourceId>/<path>"
  // (same shape as `benign`). benchmark.mjs reads this list and, when one of these produces a false
  // negative, prints WHY next to it -- so a fresh clone's red score cannot be misread as an engine
  // regression. The expectations stay in place and still count: the miss is real for whoever is running,
  // it just has a known non-engine cause. `.gitignore` is the authority on which files these are and why;
  // this list only names them so the score can point at that reason.
  "untracked": [
    "api/services/be-security.hardcoded-secret.ts"
  ]
}
