#!/usr/bin/env bash
# pre-commit — runs the repo's mechanical guards before every commit.
#
# Enable once per clone (no dependency on husky or any package manager; plain git):
#   git config core.hooksPath .githooks
#
# Scope: the fast guards, plus ONE conditional slow stage at the bottom. cargo test/clippy are still
# excluded (too slow for a hook, on every commit; CI owns them).
#
# The parser-fingerprint guard used to run here. It is gone (2026-07-29): every fingerprint it
# policed is now derived from a hash of the source that produces the cached bytes
# (crates/engine/build.rs), so there is no bump to forget and nothing to check.
#
# Which bytes the guards read: the WORKING TREE, not the index — a violation in an unstaged file also
# blocks the commit; stash if that's ever wrong. ONE guard deliberately differs:
# check-vendor-token-literals scans the INDEX as well, because its subject is what a push carries and
# a commit carries staged content, not working-tree content (see its header for the false green that
# forced this). Its index pass reads $GIT_INDEX_FILE, which git sets for this hook — so it judges the
# right bytes under `git commit -a` and `git commit <paths>` too, both of which build a temporary
# index before running us.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

GUARDS=(
  check-english-source
  check-max-file-lines
  check-swc-isolation
  check-ruff-isolation
  check-syn-isolation
  check-tree-sitter-isolation
  check-dep-closure
  check-rule-extension-closure
  check-git-spawn-isolation
  check-guards-wired
  check-rules-catalog-sync
  check-catalog-severity-sync
  check-message-band-claims
  check-shipped-off-sync
  check-site-generated
  check-rule-desc-tokens
  check-pack-suppress-sentence
  check-matcher-glossary-sync
  check-docs-rule-ids
  check-doc-config-keys
  check-prose-rule-ids
  check-runtime-text-rule-ids
  check-marker-claims
  check-pack-id-values
  check-docs-link-graph
  check-io-key-vocab
  check-policy-census
  check-retired-config-vocabulary
  check-ci-local-mirrors-ci
  check-convention-vocab-declarable
  check-committed-config-vocabulary
  check-config-surface-read-by
  check-shell-pipe-sigpipe
  check-shell-mute-floor
  check-shell-herestring-scale
  check-version-lists-parsers
  check-framework-prose-enumeration
  check-asset-name-prose
  check-deploy-facts-prose
  check-overclaim-prose
  check-version-relative-prose
  check-vendor-token-literals
  check-server-json-hashes
  check-release-version-propagation
  check-embedded-contract-docs
  check-license-shipping
  check-fragment-fixture-pairing
  check-mcp-tools-listed
  check-cli-flags-documented
  check-rule-id-renames-recorded
  check-ci-job-timeouts
  check-cached-finding-producers
)

for g in "${GUARDS[@]}"; do
  if ! out=$(bash "scripts/$g.sh" 2>&1); then
    echo "pre-commit: scripts/$g.sh FAILED"
    echo "$out"
    exit 1
  fi
done
echo "pre-commit: ${#GUARDS[@]} guards clean."

# The one stage that is NOT a guard and NOT unconditional.
#
# None of the guards above opens cases/, so until now nothing on this side of a push compared real
# findings to the adjudicated answer key. The gate that does was reachable only from
# scripts/ci-local.sh, which runs once per batch and after the work. Measured consequence: the gate was
# red for roughly ninety commits starting at 9b89e62 (2026-08-21) and three separate commits each took
# a piece of it without any of them running it.
#
# It runs LAST because it is the expensive one. MEASURED on this machine: the guards above cost 287s
# on an idle box and 586s while another batch was compiling; the gate adds 171s on top of that against
# a warm target, and 2-3 min more when the release build is cold. It runs only when the staged set can
# move a finding, which over the last 96 commits was 65.6% of them.
# The script owns the trigger, the announcement and the escape hatch; read its header for what the
# trigger is blind to (crates/, notably) before quoting a green run as "detection is fine".
# The README reproduction block is a COPY of numbers only a run knows, and it went stale four times
# before anything checked it (the fourth shipped in v0.34.0 with all guards green). This verifier is
# deliberately NOT a scripts/check-*.sh, for the reason detection-benchmark states in ci.yml: that
# would oblige every commit to afford a release build. It arms itself off the index instead, and is
# a no-op unless README.md or the fixture tree is staged.
bash scripts/measure/readme-result-block.sh

bash scripts/detection-gate-if-touched.sh

# The other half of that gate's signal, and the half the ninety-commit episode actually turned on.
# The line above runs the gate when this commit stages a path that can move a finding; it says nothing
# on the commits that stage none — which is most of them, and every one of the commits over which a red
# verdict would sit unread. A failing gate leaves its verdict in one terminal and nowhere else, so
# `not armed` after a red and `not armed` after a green are the same bytes. This reads the verdict
# detection-gate.sh now records and prints it at every commit. It never refuses: see its header, and
# scripts/unseen-commits.sh below for the precedent it follows.
bash scripts/detection-gate-staleness.sh

# Same shape, a different subject: the guards above are text checks and none of them loads a rule pack
# and asserts on it. A pack edit that splits an invariant between two rules is invisible to every one of
# them AND to the detection gate (cases/trees holds no file of the extension that showed it) -- so it
# stayed red for a commit with everything green (review ledger V137). Armed off the index; ~15% of
# commits stage rules/dsl/. Its header owns the cost and the escape hatch.
bash scripts/rule-pack-tests-if-touched.sh

bash scripts/unseen-commits.sh
